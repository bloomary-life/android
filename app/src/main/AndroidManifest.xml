<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".application.app.BloomaryApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:forceDarkAllowed="false"
        android:theme="@style/Theme.Bloomary">

        <!-- Sentry is initialised programmatically from CrashReporter; the values
             below mirror the SentryDSN/SentryEnvironment/SentryTracesSampleRate
             keys the iOS app reads from Info.plist at boot. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <meta-data
            android:name="SentryDSN"
            android:value="" />
        <meta-data
            android:name="SentryEnvironment"
            android:value="production" />
        <meta-data
            android:name="SentryTracesSampleRate"
            android:value="0.1" />

        <activity
            android:name=".application.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- bloomary://linkedin-connected — LinkedIn CLI OAuth callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="bloomary"
                    android:host="linkedin-connected" />
            </intent-filter>

            <!-- bloomary://editor — carried by server notifications -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="bloomary"
                    android:host="editor" />
            </intent-filter>
        </activity>

        <!-- FCM token refresh + server notifications; registers the token with the
             backend like the iOS NotificationTokenService APNs flow. Requires
             google-services.json at build time to receive events. -->
        <service
            android:name=".features.notifications.api.PushTokenMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
